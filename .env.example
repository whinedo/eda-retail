POSTGRES_USER=eda
POSTGRES_PASSWORD=eda
POSTGRES_DB=eda
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
DATABASE_URL=postgresql://eda:eda@localhost:5432/eda

# LLM local con Ollama (los tests usan siempre el cliente falso)
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct
LLM_SEED=42
LLM_TIMEOUT_SECONDS=120
LLM_MAX_GENERATIONS=3
LLM_MAX_TOKENS_PER_INCIDENT=50000
LLM_MAX_CALLS_PER_INCIDENT=10
MAX_PLAN_REVISIONS=2
STEP_MAX_ATTEMPTS=3
STEP_BACKOFF_BASE_SECONDS=0.5
STEP_BACKOFF_MAX_SECONDS=10
EXECUTOR_MAX_CONCURRENCY=5

# Worker de los comandos con trabajo largo (CreatePlan, RevisePlan y ExecuteStep de los ejecutores)
JOB_LEASE_SECONDS=600
JOB_POLL_INTERVAL_S=0.2
JOB_RETRY_BASE_SECONDS=1
JOB_RETRY_MAX_SECONDS=30
JOB_MAX_ATTEMPTS=5

# Versión de la PoC: 1 (por defecto) o 2 (añade el servidor de correo MCP y el agente del transportista A2A)
POC_VERSION=1

# Agente del transportista (A2A, solo con POC_VERSION=2): run-agents.sh arranca eda-carrier-agent y el
# planificador lo consulta antes del LLM. A2A_CARRIER_TOKEN es obligatorio con la versión 2: pon un valor
# propio en .env (nunca en el repositorio).
CARRIER_AGENT_URL=http://127.0.0.1:8130
CARRIER_AGENT_PORT=8130
A2A_CARRIER_TOKEN=
A2A_TIMEOUT_S=5
A2A_MAX_ROUNDS=2
CARRIER_AGENT_SEED=42
