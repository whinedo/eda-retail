POSTGRES_USER=eda
POSTGRES_PASSWORD=eda
POSTGRES_DB=eda
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
DATABASE_URL=postgresql://eda:eda@localhost:5432/eda

# LLM local con Ollama (los tests usan siempre el cliente falso)
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct
LLM_SEED=42
LLM_TIMEOUT_SECONDS=120
LLM_MAX_GENERATIONS=3
LLM_MAX_TOKENS_PER_INCIDENT=50000
LLM_MAX_CALLS_PER_INCIDENT=10
MAX_PLAN_REVISIONS=2
STEP_MAX_ATTEMPTS=3
STEP_BACKOFF_BASE_SECONDS=0.5
STEP_BACKOFF_MAX_SECONDS=10
EXECUTOR_MAX_CONCURRENCY=5
A2A_CARRIER_TOKEN=933c0f3b6b25bfe13b5b3ba38b59e80e3836911e1ed15dc8babda15c1c52ade0
SHIPPING_COST_PCT=10
REFUND_OVER_REISSUE_PCT=120
WEB_SUPPORT=true
WEB_INTERACTIVE=true
WEB_FREE_TEXT=true
POC_VERSION=2
MAX_UNTRUSTED_INPUT_CHARS=8000
# Graba peticiones y respuestas del LLM (calls-*.jsonl) y cada ejecución del harness (outcomes-*.jsonl)
LLM_RECORD_DIR=
# Con LLM_CLIENT=replay: directorio grabado que se reproduce sin contactar con ningún modelo
LLM_REPLAY_DIR=
